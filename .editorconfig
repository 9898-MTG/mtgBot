# EditorConfig — consistent formatting across all editors and file types
# https://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[*.{html,css}]
indent_size = 4

[*.{cs,razor}]
indent_size = 4

[Makefile]
indent_style = tab
