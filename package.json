{
    "name": "mtgbot",
    "version": "1.0.0",
    "description": "Magic: The Gathering Discord Bot & Web Development Platform",
    "private": true,
    "workspaces": [
        "discord/BotFiles"
    ],
    "scripts": {
        "lint": "eslint . --ext .js",
        "lint:fix": "eslint . --ext .js --fix",
        "format": "prettier --write \"**/*.{js,json,md,html,css}\"",
        "format:check": "prettier --check \"**/*.{js,json,md,html,css}\"",
        "test": "jest --passWithNoTests",
        "test:watch": "jest --watch --passWithNoTests",
        "validate": "npm run lint && npm run test",
        "validate:json": "node scripts/validateJson.js",
        "build:toc": "python3 scripts/generate_toc.py",
        "generate:nav": "node scripts/generateNavPages.js",
        "generate:hooks": "node scripts/generateHookDocs.js",
        "improve": "node scripts/improveFiles.js",
        "improve:content": "node scripts/improve_content.js",
        "maintain": "node scripts/weeklyMaintenance.js",
        "maintain:dry": "node scripts/weeklyMaintenance.js --dry-run",
        "tasks": "node scripts/taskScheduler.js",
        "tasks:dry": "node scripts/taskScheduler.js --dry-run",
        "tasks:daily": "node scripts/taskScheduler.js --execute daily",
        "tasks:weekly": "node scripts/taskScheduler.js --execute weekly",
        "tasks:monthly": "node scripts/taskScheduler.js --execute monthly",
        "tasks:yearly": "node scripts/taskScheduler.js --execute yearly"
    },
    "devDependencies": {
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "prettier": "^3.2.0"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/__tests__/**/*.test.js",
            "**/*.test.js"
        ],
        "collectCoverageFrom": [
            "discord/BotFiles/**/*.js",
            "hooks/**/*.js",
            "lib/**/*.js",
            "!**/node_modules/**"
        ]
    }
}
